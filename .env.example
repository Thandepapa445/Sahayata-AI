# ==============================================================================
# SAHAYATA AI (सहायता AI) — Environment Configuration Template
# Copy this file to .env and configure local values.
# NEVER commit .env to version control.
# ==============================================================================

# --- Application Environment ---
ENVIRONMENT=development
DEBUG=True
APP_NAME="SAHAYATA AI"
APP_VERSION="0.1.0"

# --- Backend Server ---
HOST=127.0.0.1
PORT=8000
BACKEND_CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]

# --- Frontend ---
VITE_API_BASE_URL="http://127.0.0.1:8000"
VITE_WS_BASE_URL="ws://127.0.0.1:8000"

# --- Compute Device Selection (cpu | cuda) ---
# Set to 'cuda' on systems with NVIDIA GPUs (e.g. RTX 3050, DGX A100), or 'cpu'
DEVICE=cpu

# --- Model Paths ---
ISL_MODEL_PATH="models/isl_classifier.pth"
YOLO_MODEL_PATH="models/yolov8n.pt"

# --- Indian Sign Language (ISL) Inference Config ---
ISL_SEQUENCE_LENGTH=30
ISL_CONFIDENCE_THRESHOLD=0.80
ISL_DEBOUNCE_FRAMES=10

# --- High-Performance Compute (DGX A100) Config ---
# Used only during campus sessions
DGX_JOB_USER=""
DGX_WORKSPACE_DIR=""
